# Apni Groq API key yahan paste karo (bina key ke bot jawab nahi dega)
# Free key: console.groq.com → Sign up (Google se) → API Keys → Create API Key
# Key gsk_ se shuru hoti hai — kabhi chat mein paste mat karo
GROQ_API_KEY=PASTE_YOUR_KEY_HERE

# Model (optional — default openai/gpt-oss-120b; tez/halka alternative: openai/gpt-oss-20b)
# MODEL_NAME=openai/gpt-oss-120b

# Server port (default 3000)
PORT=3000

# --- WhatsApp Cloud API (webhook ke liye) ---
# Meta for Developers → apni app → WhatsApp → API Setup se milte hain
WHATSAPP_TOKEN=PASTE_YOUR_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_YOUR_PHONE_NUMBER_ID_HERE
# VERIFY_TOKEN tum khud koi random string rakho (jaise chaudhry-estate-verify-123)
# — yehi string Meta dashboard mein webhook lagate waqt bhi likhni hai
VERIFY_TOKEN=PASTE_YOUR_VERIFY_TOKEN_HERE
# Optional (security): Meta app → Settings → Basic → App Secret
# WHATSAPP_APP_SECRET=PASTE_YOUR_APP_SECRET_HERE
